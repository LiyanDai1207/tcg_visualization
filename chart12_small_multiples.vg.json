{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples of sets released per year for each game, 1993-2025, on a shared scale.",
  "data": {
    "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/sets_by_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "sets": "number",
        "cards": "number"
      }
    }
  },
  "facet": {
    "column": {
      "field": "game",
      "type": "nominal",
      "title": null,
      "sort": [
        "Magic: The Gathering",
        "Pokémon",
        "Yu-Gi-Oh!"
      ],
      "header": {
        "labelFontWeight": "bold",
        "labelFontSize": 11,
        "labelAnchor": "start",
        "labelColor": "#333",
        "labelExpr": "datum.value == 'Magic: The Gathering' ? 'Magic' : datum.value"
      }
    }
  },
  "spacing": 14,
  "spec": {
    "width": 112,
    "height": 250,
    "layer": [
      {
        "mark": {
          "type": "line",
          "strokeWidth": 2,
          "interpolate": "monotone"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                1993,
                2025
              ]
            },
            "axis": {
              "format": "d",
              "values": [
                1995,
                2010,
                2025
              ],
              "grid": false
            }
          },
          "y": {
            "field": "value",
            "type": "quantitative",
            "title": null,
            "axis": {
              "grid": true,
              "gridColor": "#ececec",
              "format": ",.0f"
            }
          },
          "color": {
            "field": "game",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": [
                "Magic: The Gathering",
                "Pokémon",
                "Yu-Gi-Oh!"
              ],
              "range": [
                "#b5562c",
                "#c99a1e",
                "#4b3f8f"
              ]
            }
          },
          "tooltip": [
            {
              "field": "game",
              "title": "Game"
            },
            {
              "field": "year",
              "type": "quantitative",
              "title": "Year",
              "format": "d"
            },
            {
              "field": "sets",
              "type": "quantitative",
              "title": "Sets released"
            },
            {
              "field": "cards",
              "type": "quantitative",
              "title": "New cards",
              "format": ","
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "measure12 == 'sets' && datum.game == 'Magic: The Gathering' && datum.year == 2022"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 30,
          "color": "#7f3414"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "field": "value",
            "type": "quantitative"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "measure12 == 'sets' && datum.game == 'Magic: The Gathering' && datum.year == 2022"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 0,
          "dy": 0,
          "fontSize": 10,
          "lineBreak": "\n",
          "color": "#7f3414"
        },
        "encoding": {
          "x": {
            "datum": 1994,
            "type": "quantitative"
          },
          "y": {
            "datum": 36,
            "type": "quantitative"
          },
          "text": {
            "value": [
              "11 sets in 2010,",
              "24 in 2022"
            ]
          }
        }
      }
    ]
  },
  "params": [
    {
      "name": "measure12",
      "value": "sets",
      "bind": {
        "input": "select",
        "options": [
          "sets",
          "cards",
          "avg"
        ],
        "labels": [
          "Sets released",
          "New cards",
          "Average cards per set"
        ],
        "name": "Show: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "measure12 == 'sets' ? datum.sets : measure12 == 'cards' ? datum.cards : round(datum.cards / datum.sets)",
      "as": "value"
    }
  ]
}