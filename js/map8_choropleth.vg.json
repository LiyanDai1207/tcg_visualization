          },
          {
            "name": "India",
            "v": 2,
            "lon": 79,
            "lat": 22,
            "t": "India 2"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1f2b28"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}
