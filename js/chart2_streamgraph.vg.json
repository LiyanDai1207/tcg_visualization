{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph of new cards printed per year by game, 1993-2025.",
  "width": "container",
  "height": 300,
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/sets_by_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "cards": "number",
            "sets": "number"
          }
        }
      },
      "transform": [
        {
          "impute": "cards",
          "key": "year",
          "groupby": [
            "game"
          ],
          "value": 0
        },
        {
          "impute": "sets",
          "key": "year",
          "groupby": [
            "game"
          ],
          "value": 0
        },
        {
          "calculate": "measure == 'cards' ? datum.cards : datum.sets",
          "as": "value"
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "d",
            "tickCount": 7,
            "grid": false
          },
          "scale": {
            "domain": [
              1993,
              2025
            ]
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "game",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Magic: The Gathering",
              "Pokémon",
              "Yu-Gi-Oh!"
            ],
            "range": [
              "#b5562c",
              "#c99a1e",
              "#4b3f8f"
            ]
          },
          "legend": {
            "orient": "bottom",
            "labelLimit": 0,
            "title": "Click a game to highlight it",
            "titleFontWeight": "normal",
            "titleLimit": 0
          }
        },
        "order": {
          "field": "game"
        },
        "tooltip": [
          {
            "field": "game",
            "title": "Game"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "cards",
            "type": "quantitative",
            "title": "New cards",
            "format": ","
          },
          {
            "field": "sets",
            "type": "quantitative",
            "title": "Sets released"
          }
        ],
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 0.95
          },
          "value": 0.15
        }
      },
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "game"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 10.5,
        "lineHeight": 14,
        "color": "#444",
        "text": [
          "2022-2024: Magic printed 7,700 to 8,600",
          "new cards a year as Commander and",
          "Universes Beyond products multiplied."
        ]
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        }
      }
    }
  ],
  "params": [
    {
      "name": "measure",
      "value": "cards",
      "bind": {
        "input": "select",
        "options": [
          "cards",
          "sets"
        ],
        "labels": [
          "New cards",
          "Sets released"
        ],
        "name": "Show: "
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}