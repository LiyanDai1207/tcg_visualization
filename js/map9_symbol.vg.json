
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the biggest events are",
    "subtitle": [
      "Magic: The Gathering World Championship venues, 1994-2025",
      "Circle size = number of times hosted"
    ],
    "anchor": "start"
  },
  "width": 800,
  "height": 400,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e8e8",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {"url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/worlds_venues.csv"
      },
      "transform": [
        {
          "aggregate":[
            {"op": "count", "as": "times_hosted"},
            {"op": "min", "field": "year", "as": "first_year"},
            {"op": "max", "field": "year", "as": "last_year"}
          ],
          "groupby": ["city", "country", "lat", "lon"]
        }
      ],
      "mark": {
        "type": "circle", 
        "opacity": 0.75, 
        "stroke": "white", 
        "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "lon", "type":"quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "times_hosted",
          "type": "quantitative",
          "title": "Times hosted",
          "scale": {"range": [60, 1200], "zero": false},
          "legend": {"values": [1, 4, 8]}
        },
        "color": {"value": "#e6550d"},
        "tooltrip": [
          {"field": "city", "title": "City"},
          {"field": "country", "title": "Country"},
          {"field": "times_hosted", "title": "Times hosted"},
          {"field": "first_year", "title": "First"},
          {"field": "last_year", "title": "Most recent"}
        ]
      }
    }
  ] 
}
