{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of Magic World Championship host cities, circle area = times hosted, 1994-2025.",
  "width": "container",
  "height": 230,
  "projection": {
    "type": "equalEarth",
    "fit": {
      "type": "Sphere"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7eff5",
        "stroke": null
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#cddae6",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME != 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#dcdbd5",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "LineString",
            "coordinates": [
              [
                0,
                -85
              ],
              [
                0,
                0
              ],
              [
                0,
                85
              ]
            ]
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#8fa5b8",
        "strokeWidth": 0.8,
        "strokeDash": [
          4,
          3
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/worlds_venues.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "year": "number"
          }
        }
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "times_hosted"
            },
            {
              "op": "min",
              "field": "year",
              "as": "first_year"
            },
            {
              "op": "max",
              "field": "year",
              "as": "last_year"
            }
          ],
          "groupby": [
            "city",
            "country",
            "lat",
            "lon"
          ]
        },
        {
          "filter": "datum.times_hosted >= minHost"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1,
        "color": "#b5562c"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "times_hosted",
          "type": "quantitative",
          "title": "Times hosted",
          "scale": {
            "range": [
              30,
              700
            ],
            "zero": false
          },
          "legend": {
            "values": [
              1,
              4,
              8
            ],
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "times_hosted",
            "type": "quantitative",
            "title": "Times hosted"
          },
          {
            "field": "first_year",
            "title": "First hosted"
          },
          {
            "field": "last_year",
            "title": "Most recent"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": -178,
            "lat": -12
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 9.5,
        "lineHeight": 12,
        "color": "#3d4a57",
        "text": [
          "Seattle hosted 8 times;",
          "Wizards of the Coast",
          "is based nearby."
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    }
  ],
  "params": [
    {
      "name": "minHost",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 8,
        "step": 1,
        "name": "Show cities that hosted at least this many times: "
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}