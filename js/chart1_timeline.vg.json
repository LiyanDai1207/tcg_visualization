{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annotated timeline: one tick per English card set for each game, with key milestones.",
  "vconcat": [
    {
      "width": 840,
      "height": 260,
      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/sets_all.csv",
            "format": {
              "type": "csv",
              "parse": {
                "cards": "number"
              }
            }
          },
          "mark": {
            "type": "tick",
            "thickness": 1.2,
            "size": 30,
            "opacity": 0.5,
            "clip": true
          },
          "encoding": {
            "x": {
              "field": "date",
              "type": "temporal",
              "title": null,
              "axis": {
                "format": "%Y",
                "tickCount": 10,
                "grid": false
              },
              "scale": {
                "domain": {
                  "param": "brush"
                },
                "padding": 14
              }
            },
            "y": {
              "field": "game",
              "type": "nominal",
              "title": null,
              "sort": [
                "Magic: The Gathering",
                "Pokémon",
                "Yu-Gi-Oh!"
              ],
              "axis": {
                "labelFontSize": 12,
                "labelFontWeight": "bold",
                "ticks": false,
                "domain": false,
                "labelLimit": 200
              }
            },
            "color": {
              "field": "game",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": [
                  "Magic: The Gathering",
                  "Pokémon",
                  "Yu-Gi-Oh!"
                ],
                "range": [
                  "#b5562c",
                  "#c99a1e",
                  "#4b3f8f"
                ]
              }
            },
            "tooltip": [
              {
                "field": "set_name",
                "title": "Set"
              },
              {
                "field": "date",
                "type": "temporal",
                "title": "Released",
                "format": "%d %B %Y"
              },
              {
                "field": "cards",
                "type": "quantitative",
                "title": "Cards in set"
              }
            ]
          }
        },
