{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Flow map of great-circle routes between consecutive Magic World Championship venues, 1994-2025, coloured by era.",
  "width": "container",
  "height": 300,
  "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "min(width / 5.45, height / 2.68) * (region == 'North America' ? 3.2 : region == 'Europe' ? 4.5 : region == 'Asia-Pacific' ? 2.2 : 1)"
    },
    "center": {
      "expr": "region == 'North America' ? [-98, 40] : region == 'Europe' ? [5, 50] : region == 'Asia-Pacific' ? [150, -5] : [0, 0]"
    },
    "translate": {
      "expr": "[width / 2, height / 2]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7eff5",
        "stroke": null,
        "clip": true
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#cddae6",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME != 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#dcdbd5",
        "stroke": "white",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "LineString",
            "coordinates": [
              [
                0,
                -85
              ],
              [
                0,
                0
              ],
              [
                0,
                85
              ]
            ]
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#8fa5b8",
        "strokeWidth": 0.8,
        "strokeDash": [
          4,
          3
        ],
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/worlds_venues.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "year": "number"
          }
        }
      },
      "transform": [
        {
          "window": [
            {
              "op": "lead",
              "field": "lon",
              "as": "next_lon"
            },
            {
              "op": "lead",
              "field": "lat",
              "as": "next_lat"
            },
            {
              "op": "lead",
              "field": "city",
              "as": "next_city"
            },
            {
              "op": "lead",
              "field": "year",
              "as": "next_year"
            }
          ],
          "sort": [
            {
              "field": "year",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "isValid(datum.next_lon) && datum.city != datum.next_city"
        },
        {
          "calculate": "datum.next_year <= 1998 ? '1994-1998: United States only' : datum.next_year <= 2014 ? '1999-2014: Going global' : '2015-2025: Back to the US'",
          "as": "era"
        },
        {
          "calculate": "{type: 'LineString', coordinates: [[datum.lon, datum.lat], [datum.next_lon, datum.next_lat]]}",
          "as": "route"
        },
        {
          "filter": "datum.next_year <= upTo"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "next_year",
              "as": "latest"
            }
          ]
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "opacity": 1,
        "strokeCap": "round",
        "clip": true
      },
      "encoding": {
        "shape": {
          "field": "route",
          "type": "geojson"
        },
        "color": {
          "field": "era",
          "type": "ordinal",
          "title": null,
          "scale": {
            "domain": [
              "1994-1998: United States only",
              "1999-2014: Going global",
              "2015-2025: Back to the US"
            ],
            "range": [
              "#e9a066",
              "#c2410c",
              "#4a1606"
            ]
          },
          "legend": {
            "orient": "bottom",
            "symbolType": "stroke",
            "columns": 1,
            "labelLimit": 0
          }
        },
        "strokeWidth": {
          "condition": [
            {
              "param": "hover",
              "empty": false,
              "value": 4
            },
            {
              "test": "length(data('hover_store')) == 0 && datum.next_year == datum.latest",
              "value": 3.6
            }
          ],
          "field": "era",
          "type": "ordinal",
          "legend": null,
          "scale": {
            "domain": [
              "1994-1998: United States only",
              "1999-2014: Going global",
              "2015-2025: Back to the US"
            ],
            "range": [
              1.8,
              1.9,
              2.6
            ]
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "From year"
          },
          {
            "field": "city",
            "title": "From"
          },
          {
            "field": "next_year",
            "title": "To year"
          },
          {
            "field": "next_city",
            "title": "To"
          }
        ],
        "opacity": {
          "condition": [
            {
              "param": "hover",
              "empty": false,
              "value": 1
            },
            {
              "test": "length(data('hover_store')) == 0",
              "value": 0.9
            }
          ],
          "value": 0.6
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/worlds_venues.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "year": "number"
          }
        }
      },
      "transform": [
        {
          "window": [
            {
              "op": "lead",
              "field": "lon",
              "as": "next_lon"
            },
            {
              "op": "lead",
              "field": "lat",
              "as": "next_lat"
            },
            {
              "op": "lead",
              "field": "city",
              "as": "next_city"
            },
            {
              "op": "lead",
              "field": "year",
              "as": "next_year"
            }
          ],
          "sort": [
            {
              "field": "year",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "isValid(datum.next_lon) && datum.city != datum.next_city"
        },
        {
          "calculate": "datum.next_year <= 1998 ? '1994-1998: United States only' : datum.next_year <= 2014 ? '1999-2014: Going global' : '2015-2025: Back to the US'",
          "as": "era"
        },
        {
          "calculate": "{type: 'LineString', coordinates: [[datum.lon, datum.lat], [datum.next_lon, datum.next_lat]]}",
          "as": "route"
        },
        {
          "filter": "datum.next_year <= upTo"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "next_year",
              "as": "latest"
            }
          ]
        },
        {
          "filter": "datum.next_year == datum.latest"
        },
        {
          "calculate": "'Highlighted: ' + datum.year + ' ' + datum.city + ' → ' + datum.next_year + ' ' + datum.next_city",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#7f3414",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "datum": -20
        },
        "latitude": {
          "datum": -62
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/worlds_venues.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "year": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "size": 22,
        "color": "#4a4a4a",
        "stroke": "white",
        "strokeWidth": 0.8,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.year <= upTo"
        }
      ]
    }
  ],
  "params": [
    {
      "name": "upTo",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 1995,
        "max": 2025,
        "step": 1,
        "name": "Show moves up to: "
      }
    },
    {
      "name": "region",
      "value": "World",
      "bind": {
        "input": "select",
        "options": [
          "World",
          "North America",
          "Europe",
          "Asia-Pacific"
        ],
        "name": "Zoom to: "
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}
